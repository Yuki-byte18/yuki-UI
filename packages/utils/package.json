{
  "name": "@yuki-byte/utils",
  "version": "0.1.0",
  "type": "module",
  "description": "YUKI-UI 组件库的工具包（BEM 类名生成 createNamespace、全局注册工具 withInstall）",
  "keywords": [
    "yuki-ui",
    "vue3",
    "bem",
    "utils"
  ],
  "author": "Yuki-byte18",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuki-byte18/yuki-UI.git",
    "directory": "packages/utils"
  },
  "homepage": "https://github.com/Yuki-byte18/yuki-UI#readme",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js"
    },
    "./with-install": {
      "types": "./dist/with-install.d.ts",
      "import": "./dist/with-install.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "create": [
        "dist/create.d.ts"
      ],
      "with-install": [
        "dist/with-install.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@10.33.1"
}
