{
  "name": "@yuki-byte/components",
  "version": "0.1.0",
  "type": "module",
  "description": "YUKI-UI 组件库的组件包（Icon / Button / Tag / Tree / Message / MessageBox / VirtualList）",
  "keywords": [
    "yuki-ui",
    "vue3",
    "component-library",
    "ui"
  ],
  "author": "Yuki-byte18",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuki-byte18/yuki-UI.git",
    "directory": "packages/components"
  },
  "homepage": "https://github.com/Yuki-byte18/yuki-UI#readme",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@yuki-byte/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@10.33.1"
}
